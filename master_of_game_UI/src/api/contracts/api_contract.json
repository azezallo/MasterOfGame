{
  "modules": {
    "auth": {
      "endpoints": [
        {
          "path": "/auth/register",
          "method": "POST",
          "description": "Register a new user",
          "request": {
            "body": {
              "login": "string",
              "password": "string"
            }
          },
          "response": {
            "success": "boolean",
            "message": "string"
          }
        },
        {
          "path": "/auth/login",
          "method": "POST",
          "description": "Authenticate user and return session cookie",
          "request": {
            "body": {
              "login": "string",
              "password": "string"
            }
          },
          "response": {
            "success": "boolean",
            "message": "string",
            "player": "Player"
          }
        },
        {
          "path": "/auth/me",
          "method": "GET",
          "description": "Get current user information",
          "request": {},
          "response": {
            "success": "boolean",
            "message": "string",
            "player": "Player"
          }
        }
      ],
      "types": {
        "Player": {
          "id": "number",
          "login": "string"
        }
      }
    },
    "sessions": {
      "endpoints": [
        {
          "path": "/sessions",
          "method": "GET",
          "description": "Get available sessions for the user",
          "request": {},
          "response": {
            "success": "boolean",
            "data": "Array<SessionMetadata>"
          }
        },
        {
          "path": "/sessions",
          "method": "POST",
          "description": "Create a new session",
          "request": {
            "body": {
              "gameName": "string",
              "characterName": "string"
            }
          },
          "response": {
            "success": "boolean",
            "data": "SessionData"
          }
        }
      ],
      "types": {
        "SessionMetadata": {
          "sessionId": "string",
          "gameName": "string",
          "characterName": "string",
          "createdAt": "number",
          "lastPlayedAt": "number",
          "version": "number"
        },
        "SessionData": {
          "session_id": "string",
          "game_name": "string",
          "character_name": "string",
          "created_at": "number",
          "last_played_at": "number"
        }
      }
    },
    "player_state": {
      "endpoints": [
        {
          "path": "/sessions/:sessionId/player-state",
          "method": "GET",
          "description": "Get current player state (attributes, magic, qualitative states, skills)",
          "request": {},
          "response": {
            "success": "boolean",
            "data": "PlayerStateProfile"
          }
        }
      ],
      "types": {
        "StateItem": {
          "name": "string",
          "timestamp": "string"
        },
        "PlayerAttributes": {
          "strength": "number",
          "agility": "number",
          "endurance": "number",
          "perception": "number",
          "willpower": "number"
        },
        "DerivedStats": {
          "max_carry_weight_kg": "number"
        },
        "MagicStats": {
          "mana_pool": "number",
          "current_mana": "number",
          "mana_flow": "number",
          "base_regen": "number"
        },
        "SkillEntry": {
          "name": "string",
          "value": "number"
        },
        "PlayerSkills": "Array<SkillEntry>",
        "PlayerStateProfile": {
          "physical_states": "Array<StateItem>",
          "body_states": "Array<StateItem>",
          "psychological_states": "Array<StateItem>",
          "attributes": "PlayerAttributes",
          "derived_stats": "DerivedStats",
          "magic_stats": "MagicStats",
          "skills": "PlayerSkills"
        }
      }
    },
    "organizations": {
      "endpoints": [
        {
          "path": "/sessions/:sessionId/organizations",
          "method": "GET",
          "description": "Get known organizations for the session",
          "request": {},
          "response": {
            "success": "boolean",
            "data": "Array<OrganizationSummary>"
          }
        },
        {
          "path": "/sessions/:sessionId/organizations/:id",
          "method": "GET",
          "description": "Get organization dossier details",
          "request": {},
          "response": {
            "success": "boolean",
            "data": "OrganizationDossier"
          }
        },
        {
          "path": "/sessions/:sessionId/organizations/:id/notes",
          "method": "PATCH",
          "description": "Update player notes for an organization",
          "request": {
            "body": {
              "content": "string"
            }
          },
          "response": {
            "success": "boolean",
            "data": {
              "content": "string",
              "last_updated": "number"
            }
          }
        }
      ],
      "types": {
        "RankDefinition": {
          "rank_id": "string",
          "rank_name": "string",
          "superior_id": "string | null",
          "privileges": "Array<string>",
          "duties": "Array<string>"
        },
        "AffiliationInteraction": {
          "timestamp": "string",
          "description": "string",
          "reputation_change": "number"
        },
        "OrganizationSummary": {
          "id": "string",
          "name": "string",
          "type": "string",
          "is_secret": "boolean",
          "description": "string",
          "player_rank": "string | null",
          "player_reputation": "number"
        },
        "OrganizationDossier": {
          "id": "string",
          "name": "string",
          "type": "string",
          "is_secret": "boolean",
          "description": "string",
          "player_rank": "string | null",
          "player_reputation": "number",
          "public_objectives": "Array<string>",
          "hierarchy": "Array<RankDefinition>",
          "mermaid_graph": "string",
          "interactions": "Array<AffiliationInteraction>",
          "player_notes": "string"
        }
      }
    },
    "magic": {
      "endpoints": [
        {
          "path": "/sessions/:sessionId/magic/spell-cost",
          "method": "POST",
          "description": "Calculate spell cost and instability risk",
          "request": {
            "body": {
              "domain": "string",
              "base_cost": "number",
              "manifestation_range_m": "number",
              "targets_life_aura": "boolean",
              "caster_skill_level": "number",
              "caster_mana_flow": "number"
            }
          },
          "response": {
            "success": "boolean",
            "data": "SpellCostResult"
          }
        },
        {
          "path": "/sessions/:sessionId/magic/regen",
          "method": "POST",
          "description": "Recalculate passive mana regeneration",
          "request": {
            "body": {
              "hours": "number",
              "location_density": "number"
            }
          },
          "response": {
            "success": "boolean",
            "data": "ManaRegenCalcResult"
          }
        },
        {
          "path": "/sessions/:sessionId/magic/evaluate-item",
          "method": "POST",
          "description": "Evaluate magic item properties",
          "request": {
            "body": {
              "properties": "MagicItemProperties"
            }
          },
          "response": {
            "success": "boolean",
            "data": "MagicItemEvaluationResult"
          }
        }
      ],
      "types": {
        "SpellCostResult": {
          "domain": "string",
          "base_cost": "number",
          "domain_multiplier": "number",
          "range_multiplier": "number",
          "manifestation_range_m": "number",
          "life_aura_cost": "number",
          "life_aura_penetrated": "boolean",
          "total_mana_cost": "number",
          "cast_time_minutes": "number",
          "can_cast_instantly": "boolean",
          "instability_risk": "number"
        },
        "ManaRegenCalcResult": {
          "multiplier": "number",
          "restored_mana": "number",
          "new_mana": "number",
          "max_mana": "number",
          "is_instant": "boolean"
        },
        "MagicItemEvaluationResult": {
          "is_valid": "boolean",
          "item_type": "string",
          "summary": "string",
          "details": "object"
        }
      }
    }
  }
}
